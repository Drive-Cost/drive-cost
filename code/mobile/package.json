{
  "name": "drivecost-mobile",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "npm --prefix ../contracts run build && tsc --noEmit",
    "test": "npm --prefix ../contracts run build && vitest run",
    "lint": "npm --prefix ../contracts run build && oxlint --config .oxlintrc.json --max-warnings 0 .",
    "check-style": "prettier --check src"
  },
  "dependencies": {
    "@drivecost/contracts": "file:../contracts",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "expo": "~55.0.6",
    "expo-crypto": "~55.0.19",
    "expo-secure-store": "~55.0.8",
    "expo-sqlite": "~55.0.10",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "^3.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "private": true,
  "overrides": {
    "@expo/require-utils": {
      "typescript": "$typescript"
    }
  }
}
