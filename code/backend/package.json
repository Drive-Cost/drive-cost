{
  "name": "drivecost-backend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Offline-first backend module for DriveCost",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/platform/postgres/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && DRIVECOST_DATA_DIR=.test-data node --test dist/modules/*/*.test.js",
    "test:postgres": "npm run build && npm run db:migrate && node --test dist/modules/auth/routes.postgres.test.js"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.0",
    "fastify": "^5.2.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
